{
  "name": "shuvi-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix web-dashboard run dev",
    "dev:web": "npm --prefix web-dashboard run dev",
    "dev:desktop": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "validate": "node scripts/validate.mjs",
    "test": "node --test scripts/*.test.mjs",
    "verify:frontend": "node scripts/run-attested.mjs --scope frontend",
    "verify:rust": "node scripts/run-attested.mjs --scope rust",
    "verify:full": "node scripts/run-attested.mjs --scope full",
    "analyze:integration": "node scripts/integration-compatibility-analyzer.mjs --base origin/phase1/safety-reconciliation-oct9 --json reports/shuvi42/integration-report.json --markdown reports/shuvi42/integration-report.md",
    "analyze:git-merge": "node scripts/git-merge-conflict-analyzer.mjs --base origin/phase1/safety-reconciliation-oct9 --json reports/shuvi42/git-merge-conflict-report.json --markdown reports/shuvi42/git-merge-conflict-report.md",
    "prepare:sha-sidecar": "node scripts/prepare-native-sha-sidecar.mjs",
    "build:windows-installer": "node scripts/check-shuvi38-tauri-version-parity.mjs && node scripts/check-shuvi38-main-binary.mjs && npm run prepare:sha-sidecar && node scripts/build-pinned-sha-installer.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
