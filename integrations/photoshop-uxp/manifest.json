{
  "manifestVersion": 5,
  "id": "com.shuvi.photoshop.bridge",
  "name": "Shuvi Photoshop Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "23.3.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "shuviPhotoshopBridge",
      "label": {"default": "Shuvi Photoshop Bridge"},
      "minimumSize": {"width": 280, "height": 220},
      "preferredDockedSize": {"width": 340, "height": 360},
      "preferredFloatingSize": {"width": 380, "height": 420}
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:17363"]
    }
  }
}
