{
  "manifestVersion": 5,
  "id": "com.shuvi.premiere.bridge",
  "name": "Shuvi Premiere Bridge",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "shuvi-premiere-panel",
      "label": {
        "default": "Shuvi Premiere Bridge"
      },
      "minimumSize": {
        "width": 300,
        "height": 260
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 500
      }
    }
  ]
}
