<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
  ExtensionBundleId="com.shuvi.audition.bridge"
  ExtensionBundleVersion="0.1.0"
  ExtensionBundleName="Shuvi Audition Bridge"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.shuvi.audition.bridge" Version="0.1.0">
      <HostList>
        <Host Name="AUDT" />
      </HostList>
    </Extension>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AUDT" Version="[13.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.shuvi.audition.bridge">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/ShuviAudition.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Shuvi Audition Bridge</Menu>
          <Geometry>
            <Size><Height>360</Height><Width>420</Width></Size>
            <MinSize><Height>260</Height><Width>300</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
